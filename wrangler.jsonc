{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rifftag",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "web"
  },
  "routes": [
    {
      "pattern": "rifftag.nobody777.com",
      "custom_domain": true
    }
  ]
}
